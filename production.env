# 生产环境配置文件
# 在部署时会被 deploy.sh 脚本使用

# 服务配置
PROJECT_NAME=webstore
SERVICE_USER=webstore
SERVICE_PORT=9001
NGINX_PORT=80

# 目录配置
PROJECT_DIR=/opt/webstore
LOG_DIR=/var/log/webstore
UPLOAD_DIR=/opt/webstore/shared_files

# Python配置
PYTHON_VERSION=3.9
FLASK_ENV=production
FLASK_DEBUG=False

# 安全配置
SECRET_KEY_FILE=/opt/webstore/.secret_key

# 文件上传限制
MAX_CONTENT_LENGTH=524288000  # 500MB in bytes

# Gunicorn配置
GUNICORN_WORKERS=auto  # 自动根据CPU核心数计算
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=2

# 日志配置
LOG_LEVEL=info
LOG_ROTATE_DAYS=30

# 备份配置
BACKUP_DIR=/opt/webstore/backups
BACKUP_RETENTION_DAYS=7